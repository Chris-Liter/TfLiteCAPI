<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ventana 1" android:textColor="@color/white" android:textSize="20dp" android:id="@+id/texto"
        tools:ignore="MissingConstraints" />


    <androidx.camera.view.PreviewView
        android:id="@+id/camara"
        tools:ignore="MissingClass"

        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter">


    </androidx.camera.view.PreviewView>

    <com.logic.tflitecapi.OverlayView
        android:id="@+id/overlay"
        android:layout_height="match_parent"
        android:layout_width="match_parent" />


    <TextView
        android:layout_width="100dp" android:textColor="@color/white" android:text=""
        android:layout_height="25dp" android:textSize="20dp" android:layout_margin="15dp"
        android:id="@+id/latencia" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"
        tools:ignore="MissingConstraints" />
    <TextView
        android:layout_width="300dp" android:textColor="@color/white" android:text=""
        android:layout_height="25dp" android:textSize="20dp"
        android:id="@+id/obje" app:layout_constraintTop_toBottomOf="@+id/latencia"
        tools:ignore="MissingConstraints" android:translationY="30dp"/>
    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:visibility="invisible"
        android:text="Numeros" android:id="@+id/numeros" android:layout_margin="20dp"
        tools:ignore="MissingConstraints" />
    <ToggleButton android:layout_margin="20dp" app:layout_constraintStart_toEndOf="@id/latencia"
        android:id="@+id/cambio" android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:ignore="MissingConstraints" />

    <ToggleButton android:id="@+id/CpuOrGpu"
        android:layout_width="wrap_content" android:visibility="invisible"
        android:layout_height="wrap_content" app:layout_constraintLeft_toRightOf="@+id/latencia"
        tools:ignore="MissingConstraints" />

</androidx.constraintlayout.widget.ConstraintLayout>