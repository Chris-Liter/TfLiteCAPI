<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:ads="http://schemas.android.com/apk/res-auto"

    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center"
    android:background="#121212">

    <TextView
        android:id="@+id/textDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:lineSpacingExtra="6dp"
        android:textAlignment="center"
        android:text="This application is natively developed in Kotlin and Java, while the object recognition process is implemented in C++. Inferences are performed using TensorFlow Lite every millisecond for each frame processed by the camera in the native C++ library. Kotlin sends the frame in Bitmap format to the C++ layer, where it is converted into an OpenCV matrix. This matrix is then processed through the TensorFlow Lite C++ API for object detection. Once the detection is completed, the C++ code returns the coordinates of the detected objects, along with their class names and confidence scores. Finally, Kotlin uses this information to draw (or render) the detected objects on the screen." />

<!--    <Button-->
<!--        android:id="@+id/btnTranslate"-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:text="ES"-->
<!--        android:layout_marginTop="20dp"-->
<!--        android:backgroundTint="#0080FF"-->
<!--        android:textColor="@android:color/white"-->
<!--        android:paddingHorizontal="25dp"-->
<!--        android:paddingVertical="10dp"/>-->

    <View
        android:layout_width="60dp"
        android:layout_height="2dp"
        android:background="#66000000"
        android:layout_marginBottom="25dp" />

    <!-- Título principal -->
    <TextView
        android:id="@+id/tituloPopup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Created by Jorge Lituma"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="10dp"
        android:shadowColor="#80000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="4" />

    <!-- Subtítulo -->
    <TextView
        android:id="@+id/tituloPopup2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Computer Science Engineer"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:fontFamily="sans-serif-light"
        android:layout_marginBottom="25dp"
        android:layout_gravity="center_horizontal" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BACK"
        android:layout_marginTop="15dp"
        android:backgroundTint="#B00020"
        android:textColor="@android:color/white"
        android:paddingHorizontal="25dp"
        android:paddingVertical="10dp"/>


    <View
        android:layout_width="60dp"
        android:layout_height="2dp"
        android:background="#66000000"
        android:layout_marginBottom="25dp" />

    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        ads:adSize="BANNER"
        ads:adUnitId=""/>


</LinearLayout>
